ashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="268" as="sourcePoint" /><mxPoint x="1090" y="268" as="targetPoint" /></mxGeometry></mxCell><mxCell id="18" value="example update" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#526975;" vertex="1" parent="1"><mxGeometry x="975" y="216" width="110" height="28" as="geometry" /></mxCell><mxCell id="19" value="" style="rounded=1;arcSize=8;html=0;fillColor=#ffffff;strokeColor=#b8ccc8;" vertex="1" parent="1"><mxGeometry x="240" y="440" width="920" height="270" as="geometry" /></mxCell><mxCell id="20" value="" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#193440;" vertex="1" parent="1"><mxGeometry x="252" y="562.85" width="896" height="24.3" as="geometry" /></mxCell><mxCell id="21" value="Additional values allowed by the database" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#193440;" vertex="1" parent="1"><mxGeometry x="275" y="465" width="850" height="35" as="geometry" /></mxCell><mxCell id="22" value="Closed and Cancelled are accepted by the status CHECK constraint.&#10;They are listed as supported values, not claimed here as demonstrated paths." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#526975;" vertex="1" parent="1"><mxGeometry x="275" y="510" width="850" height="65" as="geometry" /></mxCell><mxCell id="23" value="" style="rounded=1;arcSize=8;html=0;fillColor=#edf2f7;strokeColor=#b8ccc8;" vertex="1" parent="1"><mxGeometry x="420" y="600" width="220" height="70" as="geometry" /></mxCell><mxCell id="24" value="Closed" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#193440;" vertex="1" parent="1"><mxGeometry x="432" y="622.85" width="196" height="24.3" as="geometry" /></mxCell><mxCell id="25" value="" style="rounded=1;arcSize=8;html=0;fillColor=#edf2f7;strokeColor=#b8ccc8;" vertex="1" parent="1"><mxGeometry x="760" y="600" width="220" height="70" as="geometry" /></mxCell><mxCell id="26" value="Cancelled" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#193440;" vertex="1" parent="1"><mxGeometry x="772" y="622.85" width="196" height="24.3" as="geometry" /></mxCell><mxCell id="27" value="" style="rounded=1;arcSize=8;html=0;fillColor=#e8f3ef;strokeColor=#b8ccc8;" vertex="1" parent="1"><mxGeometry x="50" y="770" width="1300" height="132" as="geometry" /></mxCell><mxCell id="28" value="Scope and interpretation" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=17;fontStyle=1;fontColor=#193440;" vertex="1" parent="1"><mxGeometry x="62" y="785.025" width="1276" height="22.950000000000003" as="geometry" /></mxCell><mxCell id="29" value="The database CHECK constraint validates status names, not transition order.&#10;Transitions, reopening rules, and actor permissions depend on workflow logic.&#10;The dashboard displays state and history; it performs no status updates." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#526975;" vertex="1" parent="1"><mxGeometry x="62" y="817.975" width="1276" height="69" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>