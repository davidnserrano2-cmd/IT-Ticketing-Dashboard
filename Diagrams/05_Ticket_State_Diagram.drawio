<mxfile host="app.diagrams.net" version="24.7.8"><diagram name="05 / Ticket status model" id="05_Ticket_State_Diagram"><mxGraphModel grid="1" page="1" pageWidth="1400" pageHeight="930"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="05 / Ticket status model" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=30;fontStyle=1;fontColor=#193440;" vertex="1" parent="1"><mxGeometry x="50" y="34" width="1300" height="42" as="geometry" /></mxCell><mxCell id="3" value="Allowed values verified in PostgreSQL. Example lifecycle, not an enforced transition matrix." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#526975;" vertex="1" parent="1"><mxGeometry x="50" y="86" width="1300" height="45" as="geometry" /></mxCell><mxCell id="4" value="" style="rounded=1;arcSize=8;html=0;fillColor=#ffffff;strokeColor=#b8ccc8;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="230" height="115" as="geometry" /></mxCell><mxCell id="5" value="New request" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#193440;" vertex="1" parent="1"><mxGeometry x="72" y="238.85" width="206" height="24.3" as="geometry" /></mxCell><mxCell id="6" value="Ticket creation" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#526975;" vertex="1" parent="1"><mxGeometry x="72" y="273.15" width="206" height="23" as="geometry" /></mxCell><mxCell id="7" value="" style="rounded=1;arcSize=8;html=0;fillColor=#edf2f7;strokeColor=#b8ccc8;" vertex="1" parent="1"><mxGeometry x="390" y="210" width="230" height="115" as="geometry" /></mxCell><mxCell id="8" value="Open" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#193440;" vertex="1" parent="1"><mxGeometry x="402" y="255.35" width="206" height="24.3" as="geometry" /></mxCell><mxCell id="9" value="" style="rounded=1;arcSize=8;ht